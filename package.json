{
  "name": "playerok-api",
  "version": "0.1.0",
  "description": "Optimal, zero-config-fuss TypeScript starter",
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "zod": "^4.4.3"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test tests/catalog-items.test.ts",
    "test:integration": "node --env-file=.env --import tsx --test tests/catalog-items.integration.test.ts tests/catalog-filters.integration.test.ts tests/endpoints.integration.test.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm run typecheck && pnpm run lint",
    "clean": "rimraf dist coverage",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run build",
    "docs": "typedoc",
    "docs:check": "typedoc --treatWarningsAsErrors"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/node": "^26.2.0",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3"
  }
}
